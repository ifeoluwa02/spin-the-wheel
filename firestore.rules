rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Campaign configuration and real-time inventory sub-collections
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Participants: allow creation with valid fields; block anonymous updates and mass deletions
    match /participants/{participantId} {
      allow read: if true;
      allow create: if request.resource.data.name is string 
                    && request.resource.data.phone is string
                    && request.resource.data.campaignId is string;
      allow update: if false; // Prevents prize or voucher tampering post-spin
      allow delete: if false; // Prevents competitor or rogue deletion of participant audit logs
    }

    // Super Admin config — blocks public reading of master credentials
    // Permits write only during initial first-run onboarding
    match /config/{docId} {
      allow read: if docId != "superAdmin";
      allow write: if docId != "superAdmin" || !exists(/databases/$(database)/documents/config/superAdmin);
    }
  }
}
