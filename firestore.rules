rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Campaign configuration (read & write for campaign setup and admin dashboard)
    match /campaigns/{campaignId} {
      allow read, write: if true;
    }

    // Participants (attendees submit spins; admin dashboard & TV mode read results)
    match /participants/{participantId} {
      allow read, write: if true;
    }

    // Super Admin config — readable for client-side credential verification,
    // writable for first-run setup flow.
    match /config/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
