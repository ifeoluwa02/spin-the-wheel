# Firebase Configuration Keys
# Obtain these from your Firebase Console > Project Settings > General > Your Apps > Web App
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Active Campaign ID (Default: demo-campaign)
NEXT_PUBLIC_CAMPAIGN_ID=demo-campaign

# Server Auth Secret (Generate with: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))')
AUTH_SECRET=your_super_secret_64_character_hex_key_here

# MongoDB Database Configuration (apps/event-attendance)
# MongoDB Atlas format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=passflow

# Resend Email Integration (apps/event-attendance)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Events <onboarding@resend.dev>
RESEND_DAILY_LIMIT=100

