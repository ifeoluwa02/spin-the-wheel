# Passflow Event Attendance System - Environment Variables

# MongoDB Database Configuration (Atlas or Local)
# MongoDB Atlas format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# Local MongoDB format: mongodb://localhost:27017/passflow
MONGODB_URI=
MONGODB_DB_NAME=passflow

# Resend API Key (Get from https://resend.com/api-keys)
RESEND_API_KEY=r

# Email Sender Address
# Sandbox testing default: onboarding@resend.dev (Only sends to the email registered on your Resend account)
# Production custom domain: Events <tickets@yourdomain.com>
EMAIL_FROM=Events <onboarding@resend.dev>

# Daily Email Send Quota (Free tier limit is 100/day)
# Passflow will automatically queue emails for next day (00:00 UTC) once this limit is reached
RESEND_DAILY_LIMIT=100

# Authentication & Cryptographic Session Secret
AUTH_SECRET=passflow-admission-auth-secret-key-2026

# Super Admin Master Credentials
SUPER_ADMIN_EMAIL=superadmin@passflow.io
SUPER_ADMIN_PASSWORD=admin123

# Firebase Configuration (Optional - Uses fast in-memory & local cache if omitted)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mock-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

