# ─────────────────────────────────────────────────────────────────────────────
# FIELD OPERATIONS & GEOFENCE ATTENDANCE — FIREBASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Create a NEW dedicated Firebase project (e.g. "field-ops-preview") at:
# https://console.firebase.google.com
# Then create a Web App (</>) and copy its configuration keys below:

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourNewProjectApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=field-ops-preview.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=field-ops-preview
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=field-ops-preview.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Active Campaign Slug (Default: golden-morn)
NEXT_PUBLIC_CAMPAIGN_ID=golden-morn

# Supervisor Master Auth Secret
AUTH_SECRET=super_secret_field_ops_key_64_characters_hex
